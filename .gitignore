# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local IDE/editor state
.vscode/*
!.vscode/settings.json
.idea/

# Runtime and generated data
logs/
output/
*.log
config/coding_value_workspaces.json
config/coding_value_workspace_snapshots/
# Start-up preferences of this machine (last CAN channel, last Log Analyzer vehicle, ...)
config/load_config_start.json
activation.dat
activation.dat.tmp
activation-*.json

# Build/packaging artifacts
build/
dist/
*.spec

# License key material
private.pem
*.private.pem
*.key
LicenseGenerator/output/

# OS files
Thumbs.db
.DS_Store

# Q Current local databases
config/database_qcurrent/

# Local third-party drivers
driver/

# Imported per-Vehicle OEM binaries are local assets, not redistributable source.
config/vehicles/*/resources/dll/**/*.[dD][lL][lL]
config/vehicles/*/resources/dll/**/.import-*
config/vehicles/*/.dll-import.lock
config/vehicles/.vehicle-resources.lock
config/vehicles/*/ecus/*.json.recovery
config/vehicles/*/vehicle.json.recovery
